# ═══════════════════════════════════════════════════════════════════════════
# Business Twin AI — environment template
#
# Copy this file to `.env` and adjust values for your environment.
#   cp .env.example .env
#
# ⚠️  NEVER commit a real `.env` file or real API keys. This file is a
#     template — keep every secret value blank and fill them in locally /
#     in your hosting provider's secret store.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Business Twin AI
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
# Keep true only in local development. Set false in production.
APP_DEBUG=false

# ── Database ────────────────────────────────────────────────────────────────
# Postgres (local install or a managed provider such as Supabase/Neon):
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/business_twin_ai
# Local dev without Postgres (SQLite — no extra services needed):
# DATABASE_URL=sqlite+aiosqlite:///./bta_runtime.db

# ── Demo data ───────────────────────────────────────────────────────────────
# Seed the DB with a demo dataset on first startup (only runs when the DB is
# empty). Set to false once you have real data.
AUTO_SEED_DEMO=true
# Seeding API used by Settings → Data & Seeding. It replaces all data when
# `force=true` — keep it OFF in production (default).
ENABLE_SEED_API=false
# Optional: seed with YOUR OWN business / supply chain profile instead of the
# demo dataset. See demo_data.example.json in the repo root for the format.
# CUSTOM_DATA_FILE=./my-business.json

# ── LLM ─────────────────────────────────────────────────────────────────────
# Leave the keys empty to use the built-in rule-based fallbacks (fully
# functional offline demo mode). Set your own keys in production.
LLM_PROVIDER=openai            # "openai" | "gemini"
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ── News API ────────────────────────────────────────────────────────────────
# Optional keyed news provider (NewsAPI.org). Falls back to the free GDELT
# feed + curated pool when empty.
NEWS_API_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# Set a long random value in production (e.g. `openssl rand -hex 32`).
# The app warns loudly at startup if this is still the placeholder.
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Comma-separated allowed Host headers (e.g. "api.example.com"). Leave empty
# to allow any host — set this in production to block Host-header attacks.
TRUSTED_HOSTS=

# ── Reports ─────────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports
